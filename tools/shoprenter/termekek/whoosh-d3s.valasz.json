  "productDescriptions": [
    {
      "href": "https://elektromosroller.api.myshoprenter.hu/productDescriptions/cHJvZHVjdERlc2NyaXB0aW9uLXByb2R1Y3RfaWQ9Mjc5OCZsYW5ndWFnZV9pZD0x",
      "id": "cHJvZHVjdERlc2NyaXB0aW9uLXByb2R1Y3RfaWQ9Mjc5OCZsYW5ndWFnZV9pZD0x",
      "name": "Whoosh D3-S City Commute - Elektromos roller - 48V - 1200W - 15Ah",
      "metaTitle": "Whoosh D3-S City Commute elektromos roller - 1200W, 48V 15Ah, 55 km",
      "metaKeywords": "whoosh d3-s, elektromos roller, 1200W elektromos roller, 48V 15Ah, terep elektromos roller, városi elektromos roller",
      "metaDescription": "Whoosh D3-S City Commute elektromos roller: 1200W motor, 48V 15Ah akku, akár 55 km hatótáv, 11\" tubeless terepgumi, hátsó rugózás, tárcsafékek, index. Magyar garancia, veszprémi szerviz.",
      "shortDescription": "<p><span style=\"font-size:16px;\"><span style=\"color:#000000;\">Whoosh D3-S City Commute - Elektromos roller - 48V - 1200W - 15Ah</span></span></p><p><span style=\"font-size:16px;\"><span style=\"color:#000000;\">Erő. Stílus. Szabadság. 1200W-os motor, 48V 15Ah (720Wh) akkumulátor, akár 55 km hatótáv, 11\"-os tubeless terepgumik, hátsó rugós felfüggesztés, első-hátsó tárcsafék, teljes világítás indexszel. Városi ingázásra és rosszabb útra is.</span></span></p>",
      "description": "<p><span style=\"font-size:16px;\"><span style=\"color:#000000;\"><strong>Whoosh D3-S City Commute – a városi ingázó, ami a rossz úton sem áll meg.</strong></span></span></p>\n<p><span style=\"font-size:16px;\"><span style=\"color:#000000;\">Az 1200W-os motor 25°-os emelkedőt visz fel, a 11\"-os tubeless terepgumik és a hátsó rugós felfüggesztés pedig kisimítják a kátyús, kockaköves, vizes utat. Nem játékszer: 29 kg-os, alumíniumvázas, 159 kg terhelhetőségű roller, ami napi 20–50 km-es ingázásra készült.</span></span></p>\n<p><span style=\"font-size:16px;\"><span style=\"color:#000000;\"><strong>Motor és menetteljesítmény</strong></span></span></p>\n<ul>\n<li><span style=\"font-size:16px;\"><span style=\"color:#000000;\">1200W-os kefe nélküli agymotor a hátsó kerékben, erős nyomaték indulásnál és emelkedőn</span></span></li>\n<li><span style=\"font-size:16px;\"><span style=\"color:#000000;\">Végsebesség: max. 52 km/h (KRESZ szerint közúton 25 km/h-ra korlátozva használható, a fokozatok kapcsolhatók)</span></span></li>\n<li><span style=\"font-size:16px;\"><span style=\"color:#000000;\">Emelkedő: 25°</span></span></li>\n<li><span style=\"font-size:16px;\"><span style=\"color:#000000;\">Terhelhetőség: 159 kg</span></span></li>\n</ul>\n<p><span style=\"font-size:16px;\"><span style=\"color:#000000;\"><strong>Akkumulátor és hatótáv</strong></span></span></p>\n<ul>\n<li><span style=\"font-size:16px;\"><span style=\"color:#000000;\">48V 15Ah (720Wh) lítium-ion akkumulátor</span></span></li>\n<li><span style=\"font-size:16px;\"><span style=\"color:#000000;\">Hatótáv: akár 55 km (75 kg-os vezetővel, sík úton, eco fokozatban; vegyes városi használatban 35–45 km-rel számolj)</span></span></li>\n<li><span style=\"font-size:16px;\"><span style=\"color:#000000;\">Töltési idő: kb. 10 óra a mellékelt töltővel – egy éjszaka alatt tele</span></span></li>\n</ul>\n<p><span style=\"font-size:16px;\"><span style=\"color:#000000;\"><strong>Futómű, fék, biztonság</strong></span></span></p>\n<ul>\n<li><span style=\"font-size:16px;\"><span style=\"color:#000000;\">11\"-os tubeless (tömlő nélküli) terepmintás gumik – tapadás vizes aszfalton, murván, kockakövön</span></span></li>\n<li><span style=\"font-size:16px;\"><span style=\"color:#000000;\">Hátsó, független rugós felfüggesztés</span></span></li>\n<li><span style=\"font-size:16px;\"><span style=\"color:#000000;\">Első és hátsó tárcsafék</span></span></li>\n<li><span style=\"font-size:16px;\"><span style=\"color:#000000;\">Teljes világítás: erős első lámpa, első-hátsó index, hátsó- és féklámpa – éjjel minden irányból látható</span></span></li>\n<li><span style=\"font-size:16px;\"><span style=\"color:#000000;\">Széles, csúszásmentes fellépő, kitámasztó</span></span></li>\n</ul>\n<p><span style=\"font-size:16px;\"><span style=\"color:#000000;\"><strong>Kényelem</strong></span></span></p>\n<ul>\n<li><span style=\"font-size:16px;\"><span style=\"color:#000000;\">Összecsukható kormányoszlop – autó csomagtartójába, liftbe, irodába befér</span></span></li>\n<li><span style=\"font-size:16px;\"><span style=\"color:#000000;\">Kijelző a kormányon: sebesség, töltöttség, fokozat</span></span></li>\n<li><span style=\"font-size:16px;\"><span style=\"color:#000000;\">Alumínium váz, fekete-piros kivitel</span></span></li>\n</ul>\n<p><span style=\"font-size:16px;\"><span style=\"color:#000000;\"><strong>Műszaki adatok</strong></span></span></p>\n<table border=\"1\" cellpadding=\"4\" style=\"border-collapse:collapse;\">\n<tbody>\n<tr><td><strong>Motor</strong></td><td>1200W, kefe nélküli agymotor</td></tr>\n<tr><td><strong>Akkumulátor</strong></td><td>48V 15Ah (720Wh) Li-ion</td></tr>\n<tr><td><strong>Hatótáv</strong></td><td>akár 55 km</td></tr>\n<tr><td><strong>Végsebesség</strong></td><td>max. 52 km/h</td></tr>\n<tr><td><strong>Emelkedő</strong></td><td>25°</td></tr>\n<tr><td><strong>Terhelhetőség</strong></td><td>159 kg</td></tr>\n<tr><td><strong>Gumik</strong></td><td>11\" tubeless, terepmintás</td></tr>\n<tr><td><strong>Felfüggesztés</strong></td><td>hátsó, független rugós</td></tr>\n<tr><td><strong>Fék</strong></td><td>első + hátsó tárcsafék</td></tr>\n<tr><td><strong>Világítás</strong></td><td>első lámpa, indexek, hátsó- és féklámpa</td></tr>\n<tr><td><strong>Töltési idő</strong></td><td>kb. 10 óra</td></tr>\n<tr><td><strong>Tömeg</strong></td><td>29 kg</td></tr>\n<tr><td><strong>Váz</strong></td><td>alumínium, összecsukható</td></tr>\n<tr><td><strong>Tanúsítvány</strong></td><td>CE / UKCA</td></tr>\n</tbody>\n</table>\n<p><span style=\"font-size:16px;\"><span style=\"color:#000000;\"><strong>Whoosh garancia és szerviz</strong><br />\nA rollert Veszprémben összeszerelve, beállítva, feltöltve adjuk át. Magyar garancia, saját szerviz Veszprémben és Kapuváron, alkatrész-ellátás, akkumulátor-építés és tuning házon belül. Kérdésed van a típusról vagy a jogszabályi használatról? Hívj minket, segítünk választani.</span></span></p>\n<p><span style=\"font-size:16px;\"><span style=\"color:#000000;\">A hatótáv és a végsebesség a vezető súlyától, a tereptől, a hőmérséklettől és a vezetési stílustól függően eltérhet.</span></span></p>",
