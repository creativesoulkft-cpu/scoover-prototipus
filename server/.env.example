# Másold .env néven és töltsd ki. Lásd server/README.md a részletekért.

PORT=8787

# A Vite dev szerver (vagy éles frontend) origója, amit a híd CORS-on beenged.
CORS_ORIGIN=http://localhost:5173

# 'mock': nincs valódi WooCommerce, a híd szimulálja a Store API válaszát –
#         így a teljes folyamat tesztelhető WP-telepítés nélkül.
# 'live': valódi WooCommerce Store API-t hív a WOO_BASE_URL alatt.
WOO_MODE=mock

# --- csak WOO_MODE=live esetén kötelező -------------------------------
WOO_BASE_URL=https://your-woocommerce-site.example.com

# Az "Egyedi roller-fólia" variálható termék WooCommerce ID-ja (kötelező
# alapértelmezett termék, ha nincs szint szerinti variáció-térkép).
WOO_CUSTOM_PRODUCT_ID=

# Opcionális: szintenkénti variáció ID-k, ha a terméknek van pa_szint
# attribútuma (Solid/Print/Custom variációk). Ha üres, a fenti
# WOO_CUSTOM_PRODUCT_ID megy egyszerű/parent termékként.
WOO_TIER_VARIATION_IDS={"solid":0,"print":0,"custom":0}

# A "Kosárba került!" utáni átirányítás célja (checkout vagy kosár oldal).
WOO_CHECKOUT_URL=https://your-woocommerce-site.example.com/checkout/
# ------------------------------------------------------------------------

# CUSTOM (feltöltött kép) minimum elfogadott felbontása.
MIN_CUSTOM_IMAGE_WIDTH=2000
MIN_CUSTOM_IMAGE_HEIGHT=2000

# Hova mentse a feltöltött CUSTOM képeket helyben (fejlesztéshez/mock módhoz).
# Éles környezetben cseréld valódi tárhelyre/CDN-re vagy a WP média-könyvtárra.
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8787

# --- Fiók, tervek, e-mail -------------------------------------------------
# A konfigurátor nyilvános URL-je: az e-mailes linkek (megerősítés, jelszó) ide mutatnak.
APP_URL=http://localhost:5173
# Adatmappa (SQLite adatbázis, terv-előnézetek, nyomdai feladatok) – RENDSZERES MENTÉS!
DATA_DIR=data
# 'Lax' ha a frontend és a híd ugyanazon a site-on fut; 'None' + COOKIE_SECURE=1, ha külön domainen (HTTPS).
SESSION_SAMESITE=Lax
COOKIE_SECURE=0
# Levelezés: üresen a levelek a szerver naplójába íródnak (fejlesztés).
SMTP_URL=
MAIL_FROM=Scoover <no-reply@scoover.hu>

# --- Ügyfélszolgálat / nyomdai fájl (docs/print-pipeline.md) --------------
# Titok az #admin nézethez és a nyomdai végpontokhoz; és/vagy admin szerepű fiókok e-mailjei.
ADMIN_TOKEN=
ADMIN_EMAILS=
PRINT_ROLL_WIDTH_MM=610
PRINT_DPI=300
PRINT_BLEED_MM=3
PRINT_GAP_MM=6
PRINT_MARGIN_MM=10
PRINT_MIN_DPI_WARN=150
